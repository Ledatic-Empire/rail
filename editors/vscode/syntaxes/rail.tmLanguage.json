{
  "scopeName": "source.rail",
  "name": "Rail",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#operators" },
    { "include": "#builtins" },
    { "include": "#numbers" },
    { "include": "#functions" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-dash.rail",
          "match": "--.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.rail",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.rail",
              "match": "\\\\."
            },
            {
              "name": "meta.embedded.line.rail",
              "begin": "\\{",
              "end": "\\}",
              "patterns": [
                { "include": "$self" }
              ]
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.rail",
          "match": "\\b(let|in|if|then|else|match|type|import|module|export|effect|perform|handle|with|resume|foreign|link)\\b"
        },
        {
          "name": "keyword.operator.arrow.rail",
          "match": "->|\\|>"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.rail",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.rail",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.rail",
          "match": "==|!=|<=|>=|&&|\\|\\||\\+|-|\\*|/|%|<|>|="
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.rail",
          "match": "\\b(alloc_stats_snapshot|append|arena_mark|arena_reset|arr_get|arr_len|arr_new|arr_set|atan2|bit_and|bit_or|bit_xor|byte_at|byte_set|cat|ceil|channel|char_from_int|char_to_int|chars|cons|cos|err_msg|error|exp|f32_bits|fabs|fiber_await|fiber_init|fiber_yield|filter|float_arr_from_f32_file|float_arr_get|float_arr_len|float_arr_new|float_arr_set|float_arr_to_f32_file|float_to_int|floor|fma32|fneg|fold|fsqrt|head|int_to_float|is_error|join|join_thread|length|log|map|mul_shr|mutex_lock|mutex_new|mutex_unlock|not|parse_float|parse_int|pow|print|range|rc_alloc|rc_release|rc_retain|read_file|read_file_bytes|read_line|recv|reverse|rotl|rotr|round32|send|shell|shl|show|show_float|show_float_exact|shr|sin|spawn|spawn_thread|split|sqrt|str_contains|str_find|str_replace|str_split|str_sub|tail|tanh|to_float|to_int|try|write_file)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.rail",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.rail",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.rail",
          "match": "^([a-z_][a-zA-Z0-9_]*)\\s+.*="
        }
      ]
    }
  }
}
