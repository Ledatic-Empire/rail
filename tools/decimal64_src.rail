-- tools/decimal64_src.rail: GENERATED by tools/gen_runtime.rail from tools/decimal64.rail.
-- Do not edit. Edit the source, run `./rail_native run tools/gen_runtime.rail`, then bootstrap
-- twice (docs/COMPILER_BOOTSTRAP.md). CI fails when this file and the source disagree.

d64_source =
  "-- tools/decimal64.rail: a float literal's text to the 64 bits of its nearest binary64, at\n-- compile time, by integer arithmetic only (Tier 3, step 8, 2026-10-21); and, compiled into\n-- the program that calls it, parse_float at run time (the step's second half, 2026-10-22).\n--\n-- Until this file the compiler emitted every float literal as its text and called the\n-- platform's atof when the program ran. macOS's atof is correctly rounded; the Linux libc Rail\n-- ships for ARM64 accumulates and scales, and 12 of the beacon kernel's 29 literals came out\n-- one or two ulps off on a Pi (rail-plasma docs/REPLAY.md, 2026-10-21). The bits now come from\n-- here, once, when the program is compiled, so every platform holds the same double. A text\n-- parsed while the program runs (parse_float, which stdlib/json.rail's numbers go through)\n-- comes through the same conversion: the compiler carries this file's text (the generated\n-- tools/decimal64_src.rail) and adds its declarations to any program that names parse_float,\n-- whose call then lands on d64_parse_float below. No Rail program calls atof.\n--\n--   d64_fields \"1.0\"               = (1023, 0)                 sign+biased exponent, fraction\n--   d64_fields \"0.1\"               = (1019, 2702159776422298)  0x3fb999999999999a\n--   d64_fields \"5.0e-324\"          = (0, 1)                    the smallest subnormal\n--   d64_fields \"1e999\"             = (2047, 0)                 +inf, as atof gives\n--   d64_hex 1019 2702159776422298  = \"3fb999999999999a\"\n--\n-- The lexer admits W.F, W.FeSX and WeSX (digits W, F, X; S empty, + or -); no sign, so the\n-- sign bit is always 0 and the 12-bit top field is the biased exponent alone. Rounding is\n-- IEEE-754 round to nearest, ties to even, which is what CPython's float() and David Gay's\n-- strtod do, so the suite checks these bits against CPython's.\n--\n-- Method, with no shortcut: the literal is D * 10^E for an integer D (its digits) and an\n-- integer E. For E >= 0 let N = D * 10^E and T = 1; otherwise N = D and T = 10^-E. A binary\n-- shift k is chosen so that q = floor(N * 2^k / T) has 55 or 56 bits. q, and whether the\n-- division left a remainder (the sticky bit), decide the 53-bit significand by the usual\n-- rounding; the exponent is the position of q's top bit minus k. A literal whose decimal\n-- order of magnitude is past the format on either side is answered before any big integer is\n-- built, so the arrays stay a few hundred limbs at most. Big integers are int arrays of\n-- 28-bit limbs, little-endian, every function given the limb count; nothing here is reused\n-- from the stdlib because the compiler imports only tools/.\n\nd64_base = 268435456\nd64_mask = 268435455\n\nd64_is_digit c =\n  let n = char_to_int c\n  n >= 48 && n <= 57\n\n-- Digits from the front of cs, as a list of ints in reading order, and the rest.\nd64_digits cs acc =\n  if length cs > 0 then\n    if d64_is_digit (head cs) then d64_digits (tail cs) (cons (char_to_int (head cs) - 48) acc)\n    else (reverse acc, cs)\n  else (reverse acc, cs)\n\n-- The exponent digits as an int, saturating far past the format so a literal such as\n-- 1e99999999999999999999 is answered (inf) without overflowing the 63-bit int.\nd64_exp_value ds acc =\n  if length ds == 0 then acc\n  else if acc > 1000000 then acc\n  else d64_exp_value (tail ds) (acc * 10 + head ds)\n\n-- (whole digits, fraction digits, signed decimal exponent) of a literal.\nd64_parse cs =\n  let (wh, r1) = d64_digits cs []\n  let (fr, r2) = if length r1 > 0 then (if head r1 == \".\" then d64_digits (tail r1) [] else ([], r1)) else ([], r1)\n  if length r2 > 0 then\n    if head r2 == \"e\" || head r2 == \"E\" then\n      let r3 = tail r2\n      let neg = if length r3 > 0 then head r3 == \"-\" else false\n      let r4 = if length r3 > 0 then (if head r3 == \"-\" || head r3 == \"+\" then tail r3 else r3) else r3\n      let (ed, r5) = d64_digits r4 []\n      let ev = d64_exp_value ed 0\n      (wh, fr, if neg then 0 - ev else ev)\n    else (wh, fr, 0)\n  else (wh, fr, 0)\n\nd64_concat a b = if length a == 0 then b else cons (head a) (d64_concat (tail a) b)\n\nd64_strip_leading ds = if length ds > 0 then (if head ds == 0 then d64_strip_leading (tail ds) else ds) else ds\n\n-- Trailing zeros of the digit list are moved into the exponent: (digits, zeros removed).\nd64_strip_trailing_rev rs n = if length rs > 0 then (if head rs == 0 then d64_strip_trailing_rev (tail rs) (n + 1) else (rs, n)) else (rs, n)\n\n-- Bits in an int in [0, 2^62).\nd64_int_bits n = if n == 0 then 0 else 1 + d64_int_bits (n / 2)\n\n-- ---- big integers: int arrays of nl limbs, 28 bits each, little-endian ----\n\n-- a = a * m + c, in place (m * 2^28 + c must stay far below 2^62; m is 10 here).\nd64_bn_mul_small a nl i m c =\n  if i >= nl then 0\n  else\n    let t = arr_get a i * m + c\n    let _ = arr_set a i (t % d64_base)\n    d64_bn_mul_small a nl (i + 1) m (t / d64_base)\n\nd64_bn_from_digits_at a nl ds =\n  if length ds == 0 then a\n  else\n    let _ = d64_bn_mul_small a nl 0 10 (head ds)\n    d64_bn_from_digits_at a nl (tail ds)\n\nd64_bn_from_digits ds nl = d64_bn_from_digits_at (arr_new nl 0) nl ds\n\nd64_bn_mul_pow10 a nl e =\n  if e <= 0 then a\n  else\n    let _ = d64_bn_mul_small a nl 0 10 0\n    d64_bn_mul_pow10 a nl (e - 1)\n\nd64_bn_top a i = if i < 0 then 0 - 1 else if arr_get a i != 0 then i else d64_bn_top a (i - 1)\n\nd64_bn_bits a nl =\n  let i = d64_bn_top a (nl - 1)\n  if i < 0 then 0 else 28 * i + d64_int_bits (arr_get a i)\n\n-- b = a << k, a fresh array of nl limbs.\nd64_bn_shl_at a b nl i ls bs =\n  if i >= nl then b\n  else\n    let v = arr_get a i\n    let lo = bit_and (shl v bs) d64_mask\n    let hi = shr v (28 - bs)\n    let _ = if i + ls < nl then arr_set b (i + ls) (bit_or (arr_get b (i + ls)) lo) else 0\n    let _ = if i + ls + 1 < nl then arr_set b (i + ls + 1) (bit_or (arr_get b (i + ls + 1)) hi) else 0\n    d64_bn_shl_at a b nl (i + 1) ls bs\n\nd64_bn_shl a nl k = d64_bn_shl_at a (arr_new nl 0) nl 0 (k / 28) (k % 28)\n\n-- -1, 0 or 1, from the top limb down.\nd64_bn_cmp_at a b i =\n  if i < 0 then 0\n  else if arr_get a i < arr_get b i then 0 - 1\n  else if arr_get a i > arr_get b i then 1\n  else d64_bn_cmp_at a b (i - 1)\n\nd64_bn_cmp a b nl = d64_bn_cmp_at a b (nl - 1)\n\n-- a = a - b in place, for a >= b.\nd64_bn_sub_at a b nl i borrow =\n  if i >= nl then 0\n  else\n    let t = arr_get a i - arr_get b i - borrow\n    let _ = arr_set a i (if t < 0 then t + d64_base else t)\n    d64_bn_sub_at a b nl (i + 1) (if t < 0 then 1 else 0)\n\nd64_bn_sub a b nl = d64_bn_sub_at a b nl 0 0\n\n-- a = a >> 1 in place.\nd64_bn_shr1_at a nl i =\n  if i >= nl then 0\n  else\n    let up = if i + 1 < nl then bit_and (arr_get a (i + 1)) 1 else 0\n    let _ = arr_set a i (bit_or (shr (arr_get a i) 1) (shl up 27))\n    d64_bn_shr1_at a nl (i + 1)\n\nd64_bn_shr1 a nl = d64_bn_shr1_at a nl 0\n\nd64_bn_nonzero a nl = d64_bn_top a (nl - 1) >= 0\n\n-- q = floor(num / den) for a quotient under 2^57, by shift and subtract from bit 56 down; num\n-- is left holding the remainder. t is den << 56 on entry and is halved each step.\nd64_div_step num t nl i q =\n  if d64_bn_cmp num t nl >= 0 then\n    let _ = d64_bn_sub num t nl\n    q + shl 1 i\n  else q\n\nd64_div_loop num t nl i q =\n  if i < 0 then q\n  else\n    let q2 = d64_div_step num t nl i q\n    let _ = d64_bn_shr1 t nl\n    d64_div_loop num t nl (i - 1) q2\n\nd64_bn_div num den nl = d64_div_loop num (d64_bn_shl den nl 56) nl 56 0\n\n-- ---- rounding q * 2^-k (plus a sticky remainder) to binary64 ----\n\n-- (top, frac) from the 55- or 56-bit quotient q, the shift k and the sticky bit.\nd64_round q k sticky =\n  let bq = d64_int_bits q\n  let e = bq - 1 - k\n  if e > 1023 then (2047, 0)\n  else\n    let normal = e >= (0 - 1022)\n    let s = if normal then bq - 53 else bq - 53 + (0 - 1022 - e)\n    if s >= 62 then (0, 0)\n    else\n      let pw = shl 1 s\n      let m = q / pw\n      let rem = q % pw\n      let half = pw / 2\n      let odd = (m % 2) == 1\n      let up = if rem > half then true else if rem == half then (if sticky then true else odd) else false\n      let m2 = if up then m + 1 else m\n      let two52 = shl 1 52\n      if normal then\n        if m2 == (shl 1 53) then (if e + 1 > 1023 then (2047, 0) else (e + 1 + 1023, 0))\n        else (e + 1023, m2 - two52)\n      else\n        if m2 == two52 then (1, 0) else (0, m2)\n\n-- The exact path: D (digit list, no leading or trailing zeros, nd digits) times 10^e10.\nd64_exact ds nd e10 =\n  let abse = if e10 < 0 then 0 - e10 else e10\n  let nl = (4 * nd + 4 * abse + 256) / 28 + 1\n  let d = d64_bn_from_digits ds nl\n  let n0 = if e10 >= 0 then d64_bn_mul_pow10 d nl e10 else d\n  let t0 = if e10 >= 0 then d64_bn_from_digits [1] nl else d64_bn_mul_pow10 (d64_bn_from_digits [1] nl) nl abse\n  let k = 55 - (d64_bn_bits n0 nl - d64_bn_bits t0 nl)\n  let num = if k > 0 then d64_bn_shl n0 nl k else n0\n  let den = if k < 0 then d64_bn_shl t0 nl (0 - k) else t0\n  let q = d64_bn_div num den nl\n  d64_round q k (d64_bn_nonzero num nl)\n\n-- The 12-bit sign-and-exponent field and the 52-bit fraction of the literal's nearest double.\nd64_fields lit = d64_fields_chars (chars lit)\n\n-- The same, from the literal's characters (parse_float arrives here past its sign).\nd64_fields_chars cs =\n  let (wh, fr, ex) = d64_parse cs\n  let digs = d64_strip_leading (d64_concat wh fr)\n  let (rs, tz) = d64_strip_trailing_rev (reverse digs) 0\n  let ds = reverse rs\n  let nd = length ds\n  let e10 = ex - length fr + tz\n  if nd == 0 then (0, 0)\n  else if nd + e10 > 309 then (2047, 0)\n  else if nd + e10 < (0 - 323) then (0, 0)\n  else d64_exact ds nd e10\n\nd64_hex_digit d = char_from_int (if d < 10 then 48 + d else 87 + d)\n\nd64_hex_loop n w acc =\n  if w <= 0 then acc\n  else d64_hex_loop (n / 16) (w - 1) (cat [d64_hex_digit (n % 16), acc])\n\n-- The 64 bits as 16 lowercase hex characters (the form stdlib/float_hex.rail prints).\nd64_hex top frac = cat [d64_hex_loop top 3 \"\", d64_hex_loop frac 13 \"\"]\n\n-- ---- parse_float at run time: the same conversion, on a text the program holds ----\n--\n-- The compiler used to answer parse_float by calling the platform atof. Now it adds this file to the\n-- program (inject_parse_float in tools/compile.rail) and calls d64_parse_float, so a JSON\n-- number read on a Pi holds the bits the Mini's compiler would have given the literal.\n-- Read, as atof reads: leading blanks, one sign, digits with an optional fraction and\n-- exponent, or inf, infinity, nan in any letter case; whatever follows the number is ignored\n-- and a text with no number is 0.0. Not read: hex floats (atof's \"0x1p3\" is 8.0; here 0.0).\n\nd64_is_blank c = c == \" \" || c == \"\\t\" || c == \"\\n\" || c == \"\\r\"\n\nd64_skip_blanks cs = if length cs > 0 then (if d64_is_blank (head cs) then d64_skip_blanks (tail cs) else cs) else cs\n\nd64_lower c =\n  let n = char_to_int c\n  if n >= 65 && n <= 90 then char_from_int (n + 32) else c\n\n-- Whether cs begins with the lowercase word w (a char list), letter case ignored.\nd64_starts_word w cs =\n  if length w == 0 then true\n  else if length cs == 0 then false\n  else if d64_lower (head cs) == head w then d64_starts_word (tail w) (tail cs)\n  else false\n\n-- m * 2^k by k exact doublings or halvings. Each step is exact when its result is\n-- representable; d64_to_float only asks for steps that are.\nd64_scale m k =\n  if k > 0 then d64_scale (m *. 2.0) (k - 1)\n  else if k < 0 then d64_scale (m *. 0.5) (k + 1)\n  else m\n\n-- The double whose sign-and-exponent field is top (sign clear) and whose fraction is frac,\n-- by exact arithmetic alone, the reverse of stdlib/float_hex.rail: the significand is an\n-- integer below 2^53, which int_to_float converts exactly, scaled by a power of two. A\n-- normal is (2^52 + frac) * 2^(e - 52), and every value from that integer down (or up) to\n-- the result is itself a normal double, so no step rounds. A subnormal is frac * 2^-1074,\n-- and frac * 2^-j is representable for every j up to 1074 because frac has at most 52 bits.\n-- inf is 2^1024, reached by doubling past the format; NaN is 0/0 (its payload is not\n-- recoverable by arithmetic, so it is the quiet NaN float_hex prints).\nd64_to_float top frac =\n  if top == 2047 then (if frac == 0 then d64_scale 1.0 1024 else 0.0 /. 0.0)\n  else if top == 0 then d64_scale (int_to_float frac) (0 - 1074)\n  else d64_scale (int_to_float ((shl 1 52) + frac)) (top - 1023 - 52)\n\n-- The magnitude of a text whose sign has been read.\nd64_magnitude cs =\n  if d64_starts_word (chars \"inf\") cs then d64_to_float 2047 0\n  else if d64_starts_word (chars \"nan\") cs then d64_to_float 2047 1\n  else\n    let (top, frac) = d64_fields_chars cs\n    d64_to_float top frac\n\n-- The double atof would give the text, its bits decided here. A negative zero stays negative\n-- (fneg, not 0 - x).\nd64_parse_float s =\n  let cs0 = d64_skip_blanks (chars s)\n  let neg = if length cs0 > 0 then head cs0 == \"-\" else false\n  let cs = if length cs0 > 0 then (if head cs0 == \"-\" || head cs0 == \"+\" then tail cs0 else cs0) else cs0\n  let mag = d64_magnitude cs\n  if neg then fneg mag else mag\n"
