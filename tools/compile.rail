  let t103 = run_test "null_safe_eq" "type T = | T x\nmain =\n  let t = T 42\n  let a = arr_new 2 0\n  let _ = arr_set a 1 t\n  let v0 = arr_get a 0\n  let v1 = arr_get a 1\n  let z0 = if v0 == 0 then 1 else 0\n  let z1 = if v1 == 0 then 1 else 0\n  z0 * 10 + z1" "10"
  let t104 = run_test "f32_io_roundtrip" "main =\n  let src = float_arr_new 3 0.0\n  let _ = float_arr_set src 0 1.5\n  let _ = float_arr_set src 1 (0.0 -. 3.25)\n  let _ = float_arr_set src 2 0.125\n  let _ = float_arr_to_f32_file \"/tmp/rail_native_t104_f32roundtrip.bin\" src 3\n  let dst = float_arr_new 3 0.0\n  let _ = float_arr_from_f32_file \"/tmp/rail_native_t104_f32roundtrip.bin\" dst 3\n  let s = float_arr_get dst 0 +. float_arr_get dst 1 +. float_arr_get dst 2\n  let _ = print (show (to_int (s *. 8.0)))\n  0" "-13"
  -- t106: runtime type-check promotion in float ops. When one operand is
  -- a float literal and the other is an int variable that isn't statically
  -- marked (because the function body contains floats → mark_int_params
  -- skips), the O-handler must emit a runtime tst+scvtf path. Regression
  -- fix 2026-04-14, was storing tagged-int bit pattern as a subnormal double.
  let t106 = run_test "mixed_float_int_op" "fill arr i =\n  if i >= 3 then 0\n  else\n    let _ = float_arr_set arr i (0.0 + (i + 1))\n    fill arr (i + 1)\nmain =\n  let a = float_arr_new 3 0.0\n  let _ = fill a 0\n  let s = float_arr_get a 0 + float_arr_get a 1 + float_arr_get a 2\n  to_int s" "6"
  -- t107: char_to_int on a RUNTIME string (the common case, head-of-chars,
  -- split output, etc.). t93 only covered the string-literal path, which
  -- silently worked because literals aren't tag-wrapped. Runtime strings
  -- are [tag=9, len, bytes...], so without an unwrap the codegen reads
  -- byte 0 = tag = 9 and returns 9 for every character. socket.rail's
  -- parse_int was silently broken by this, now `char_to_int c - 48`
  -- actually gives the digit value. Fix 2026-04-15.
  let t107 = run_test "char_to_int_runtime" "main =\n  let c = head (chars \"9\")\n  char_to_int c" "57"
  -- Track H: bit-operation primitives (foundation for SHA-256, ChaCha20, AEAD).
  let t111 = run_test "bit_and" "main = bit_and 255 15" "15"
  let t112 = run_test "bit_or"  "main = bit_or 240 15" "255"
  let t113 = run_test "bit_xor_identity" "main = bit_xor 4660 4660" "0"
  let t114 = run_test "shl_basic" "main = shl 1 4" "16"
  let t115 = run_test "shr_basic" "main = shr 65280 8" "255"
  let t116 = run_test "rotl_roundtrip" "main = rotl 256 56" "1"
  -- ROTR32(0xDEADBEEF, 2) = ((x>>2)|(x<<30)) & 0xFFFFFFFF = 4155207611
  let t117 = run_test "rotr32_composed" "main =\n  let x = 3735928559\n  let a = shr x 2\n  let b = shl x 30\n  let c = bit_or a b\n  let r = bit_and c 4294967295\n  let _ = print (show r)\n  0" "4155207611"
  -- Track H Layer 1: SHA-256 against NIST test vectors.
  let t118 = run_test "sha256_empty" "import \"stdlib/sha256.rail\"\nmain =\n  let _ = print (sha256_hex \"\")\n  0" "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
  let t119 = run_test "sha256_abc" "import \"stdlib/sha256.rail\"\nmain =\n  let _ = print (sha256_hex \"abc\")\n  0" "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
  -- 56-byte input exercises the two-final-block padding path (rem+9 > 64).
  let t120 = run_test "sha256_two_blocks" "import \"stdlib/sha256.rail\"\nmain =\n  let _ = print (sha256_hex \"abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq\")\n  0" "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1"
  -- Track H Layer 2: HMAC-SHA256 (RFC 4231) + HKDF-SHA256 (RFC 5869).
  let t121 = run_test "hmac_sha256_jefe" "import \"stdlib/hmac.rail\"\nmain =\n  let _ = print (hmac_sha256_hex \"Jefe\" \"what do ya want for nothing?\")\n  0" "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843"
  let t122 = run_test "hkdf_rfc5869_tc1" "import \"stdlib/hkdf.rail\"\nmain =\n  let ikm = hex_to_bytes \"0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b\"\n  let salt = hex_to_bytes \"000102030405060708090a0b0c\"\n  let info = hex_to_bytes \"f0f1f2f3f4f5f6f7f8f9\"\n  let prk = hkdf_extract salt 13 ikm 22\n  let okm = hkdf_expand prk info 10 42\n  let _ = print (bytes_to_hex okm 42)\n  0" "3cb25f25faacd57a90434f64d0362f2a2d2d0a90cf1a5a4c5db02d56ecc4c5bf34007208d5b887185865"
  -- Track H Layer 3a: ChaCha20 stream cipher (RFC 8439 §2.3.2 keystream block).
  let t123 = run_test "chacha20_block" "import \"stdlib/bytes.rail\"\nimport \"stdlib/chacha20.rail\"\nmain =\n  let key = hex_to_bytes \"000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f\"\n  let nonce = hex_to_bytes \"000000090000004a00000000\"\n  let b = chacha20_block key nonce 1\n  let _ = print (bytes_to_hex b 64)\n  0" "10f1e7e4d13b5915500fdd1fa32071c4c7d1f4c733c068030422aa9ac3d46c4ed2826446079faa0914c2d705d98b02a2b5129cd1de164eb9cbd083e8a2503c4e"
  -- Track H Layer 3b: Poly1305 MAC (RFC 8439 §2.5.2).
  let t124 = run_test "poly1305_mac" "import \"stdlib/bytes.rail\"\nimport \"stdlib/poly1305.rail\"\nmain =\n  let key = hex_to_bytes \"85d6be7857556d337f4452fe42d506a80103808afb0db2fd4abff6af4149f51b\"\n  let msg = string_to_bytes \"Cryptographic Forum Research Group\"\n  let tag = poly1305_mac key msg 34\n  let _ = print (bytes_to_hex tag 16)\n  0" "a8061dc1305136c6c22b8baf0c0127a9"
  -- Track H Layer 3b-glue: ChaCha20-Poly1305 AEAD tag (RFC 8439 §2.8.2).
  let t125 = run_test "aead_tag" "import \"stdlib/bytes.rail\"\nimport \"stdlib/aead.rail\"\nmain =\n  let key = hex_to_bytes \"808182838485868788898a8b8c8d8e8f909192939495969798999a9b9c9d9e9f\"\n  let nonce = hex_to_bytes \"070000004041424344454647\"\n  let aad = hex_to_bytes \"50515253c0c1c2c3c4c5c6c7\"\n  let pt = string_to_bytes \"Ladies and Gentlemen of the class of '99: If I could offer you only one tip for the future, sunscreen would be it.\"\n  let r = aead_encrypt key nonce aad 12 pt 114\n  let _ = print (bytes_to_hex (arr_get r 1) 16)\n  0" "1ae10b594f09e26a7e902ecbd0600691"
  -- Track H Layer 4: X25519 scalar multiplication (RFC 7748 §5.2 Vector 1).
  let t126 = run_test "x25519_rfc7748_v1" "import \"stdlib/bytes.rail\"\nimport \"stdlib/x25519.rail\"\nmain =\n  let s = hex_to_bytes \"a546e36bf0527c9d3b16154b82465edd62144c0ac1fc5a18506a2244ba449ac4\"\n  let u = hex_to_bytes \"e6db6867583030db3594c1a424b15f7c726624ec26b3353b10a903a6d0ab1c4c\"\n  let _ = print (bytes_to_hex (x25519 s u) 32)\n  0" "c3da55379de9c6908e94ea4df28d084f32eccf03491c71f754b4075577a28552"
  -- Track H Layer 5: TLS 1.3 key schedule (RFC 8446 Appendix A.1).
  let t127 = run_test "tls13_key_schedule" "import \"stdlib/tls13.rail\"\nmain =\n  let e = hex_to_bytes \"8bd4054fb55b9d63fdfbacf9f04b9f0d35e6d63f537563efd46272900f89492d\"\n  let h = hex_to_bytes \"860c06edc07858ee8e78f0e7428c58edd6b43f2ca3e6e95f02ed063cf0e1cad8\"\n  let s = tls13_derive_schedule e 32 h h\n  let _ = print (bytes_to_hex (arr_get s 1) 32)\n  0" "b3eddb126e067f35a780b3abf45e2d8f3b1a950738f52e9600746a0e27a55a21"
  let t128 = run_test "tls13_client_hello" "import \"stdlib/tls13_hs.rail\"\nmain =\n  let z = arr_new 32 0\n  let r = tls13_client_hello z z z \"example.com\"\n  let _ = print (bytes_to_hex (arr_get r 0) (arr_get r 1))\n  0" ""
  let t129 = run_test "tls13_parse_server_hello" "import \"stdlib/tls13_hs.rail\"\nmain =\n  let sh = hex_to_bytes \"020000560303a6af06a4121860dc5e6e60249cd34c95930c8ac5cb1434dac155772ed3e2692800130100002e00330024001d0020c9828876112095fe66762bdbf7c672e156d6cc253b833df1dd69b1b04e751f0f002b00020304\"\n  let r = tls13_parse_server_hello sh 90\n  let _ = print (cat [show (arr_get r 3), \" \", show (arr_get r 1), \" \", bytes_to_hex (arr_get r 2) 32])\n  0" "1 4865 c9828876112095fe66762bdbf7c672e156d6cc253b833df1dd69b1b04e751f0f"
  let t130 = run_test "tls13_record_roundtrip" "import \"stdlib/tls13.rail\"\nimport \"stdlib/tls13_record.rail\"\nmain =\n  let key = hex_to_bytes \"808182838485868788898a8b8c8d8e8f909192939495969798999a9b9c9d9e9f\"\n  let iv  = hex_to_bytes \"070000004041424344454647\"\n  let frag = string_to_bytes \"Hello, TLS 1.3!\"\n  let enc = tls13_record_encrypt key iv 0 22 frag 15\n  let wire = arr_get enc 0\n  let wire_len = arr_get enc 1\n  let dec = tls13_record_decrypt key iv 0 wire wire_len\n  let _ = print (cat [bytes_to_hex wire wire_len, \" \", show (arr_get dec 3), \" \", show (arr_get dec 1), \" \", bytes_to_hex (arr_get dec 0) (arr_get dec 2)])\n  0" "1703030020d71e85316ed160ee59b1afca18b22bb8683ce64dc136d5a0b2a318ce895ca9f4 1 22 48656c6c6f2c20544c5320312e3321"
  let t131 = run_test "tls13_handshake_msg_parsers" "import \"stdlib/tls13_hs.rail\"\nmain =\n  let stream = hex_to_bytes \"0800000200000b00000e0000000a000005616263646500000f00000c08040008414243444546474814000020aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"\n  let m1 = tls13_hs_read_msg stream 0\n  let v1 = tls13_parse_encrypted_extensions stream (arr_get m1 1) (arr_get m1 2)\n  let m2 = tls13_hs_read_msg stream (arr_get m1 3)\n  let cert = tls13_parse_certificate stream (arr_get m2 1) (arr_get m2 2)\n  let m3 = tls13_hs_read_msg stream (arr_get m2 3)\n  let cv = tls13_parse_certificate_verify stream (arr_get m3 1) (arr_get m3 2)\n  let m4 = tls13_hs_read_msg stream (arr_get m3 3)\n  let fin = tls13_parse_finished stream (arr_get m4 1) (arr_get m4 2)\n  let _ = print (cat [show (arr_get m1 0), \" \", show v1, \" \", show (arr_get m2 0), \" \", show (arr_get cert 2), \" \", bytes_to_hex (arr_get cert 0) (arr_get cert 1), \" \", show (arr_get m3 0), \" \", show (arr_get cv 0), \" \", bytes_to_hex (arr_get cv 1) (arr_get cv 2), \" \", show (arr_get m4 0), \" \", show (arr_get fin 2), \" \", bytes_to_hex (arr_get fin 0) (arr_get fin 1)])\n  0" "8 1 11 1 6162636465 15 2052 4142434445464748 20 1 aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
  -- t132/t133: 3-movk and 4-movk integer literals. Pre-fix, emit_load_int
  -- only handled lo/hi/hi1/hi2 chunks (bits 0-47), and hi2 was unmasked so
  -- it overflowed 16 bits for bit-48+ literals -> `as: immediate must be
  -- in range [0, 65535]`. Diff_fuzz LCG seed surfaced the bug 2026-05-11.
  -- t132 exercises a 3-movk literal (bit 40 set). t133 exercises a 4-movk
  -- literal (bit 48 set). Negative variant (t134) tests the movn path.
  let t132 = run_test "int_lit_3movk" "main =\n  let n = 1099511627776\n  let _ = print (show n)\n  0" "1099511627776"
  let t133 = run_test "int_lit_4movk" "main =\n  let n = 281474976710656\n  let _ = print (show n)\n  0" "281474976710656"
  let t134 = run_test "int_lit_4movk_neg" "main =\n  let n = 0 - 281474976710656\n  let _ = print (show n)\n  0" "-281474976710656"
  -- t135: float-arg user fn via conservative mark_float_params.
  -- apply_sqrt's param p is marked __float_p because it's the sole arg
  -- to sqrt (a takes_only_floats_fn builtin). Caller passes raw double
  -- bits from `sqrt 16.0`'s return; callee reads same. Before mark_float_params
  -- got a real implementation (2026-05-22), this returned the tagged-int-0
  -- bit pattern (~4.94e-324) instead of 4.0.
  let t135 = run_test "float_user_fn_sqrt_arg" "foreign sqrt x -> float\napply_sqrt p = sqrt p\nmain =\n  let _ = print (show_float (apply_sqrt 16.0))\n  0" "4"
  -- t136: 2-float-arg COMPARISON user fn (the minmod class). Pre-fix, `a < b`
  -- with both params unmarked fell through to _rail_lt, which dereferences an
  -- even-LSB operand as a heap pointer -> data-dependent segfault (and wrong
  -- values for odd-LSB). The compare-against-a-float marking rule in
  -- param_is_float marks both params float so the native fcmp path is used.
  -- Real-world victim: stdlib/mhd_kernel.rail mk_minmod (the whole MUSCL path).
  let t136 = run_test "float_user_fn_minmod" "minmod a b =\n  if a > 0.0 then (if b > 0.0 then (if a < b then a else b) else 0.0)\n  else if a < 0.0 then (if b < 0.0 then (if a > b then a else b) else 0.0)\n  else 0.0\nmain =\n  let _ = print (cat [show_float (minmod 3.0 5.0), \" \", show_float (minmod 8.0 6.0)])\n  0" "3 6"
  -- t137/t138 (Increment A, a call-site pass; the types decide this since 2026-09-22):
  -- t137: every call site of mul2 passes a float -> params marked __float_ -> `a * b` is float-mul.
  -- t138 (negative guard): inc(int) stays int -> inc 5 == 6 (never mismark an int param as float).
  -- t139 (int-param dual): addk's only call site passes an INT, so x is marked __int_ and
  --   scvtf-promoted in the float context `0.0 + x` -> "5" (fixes the denormal A originally left).
  let t137 = run_test "arith_float_2arg" "mul2 a b = a * b\nmain =\n  let _ = print (show_float (mul2 3.0 4.0))\n  0" "12"
  let t138 = run_test "argf_int_param_safe" "inc x = x + 1\nmain =\n  let _ = print (show (inc 5))\n  0" "6"
  let t139 = run_test "argi_int_into_float" "addk x = 0.0 + x\nmain =\n  let _ = print (show_float (addk 5))\n  0" "5"
  -- t140 (Increment B): a float user-fn RESULT bound to a let-local composes as a
  -- float arg at a later call site. `y = mlp 1.0 2.0` (=1.125) fed to `mse y 1.0`
  -- must mark mse's pred __float_ via __vf_-threaded argf, so d*d is float-mul ->
  -- 0.015625. Before the fix infer_ty(V y)=0 demoted __argf_mse_0 -> pred untagged
  -- as int -> 5.3e+36 garbage. The inlined `mse (mlp 1.0 2.0) 1.0` always worked.
  let t140 = run_test "float_result_compose" "relu x = if x > 0.0 then x else 0.0\nneuron w1 x1 w2 x2 b = relu (w1 * x1 + w2 * x2 + b)\nmlp x1 x2 =\n  let h1 = neuron 0.5 x1 0.25 x2 0.0\n  let h2 = neuron 0.25 x1 0.5 x2 0.0\n  neuron 0.5 h1 0.5 h2 0.0\nmse pred target = let d = pred - target in d * d\nmain =\n  let y = mlp 1.0 2.0\n  let _ = print (show_float (mse y 1.0))\n  0" "0.015625"
  -- t141 (P2 Stage B / B0): the `auth` field modifier parses as a field-type prefix.
  -- `Mk auth int int` is arity 2 (auth + int = ONE authenticated field, then a plain
  -- int), constructs from 2 args, and destructures exactly like a plain ADT. auth is
  -- inert in B0 (no codegen reads the authmask yet). Mk 100 7 -> bal + tag = 107.
  let t141 = run_test "auth_field_parse_plain" "type Acc = | Mk auth int int\ntotal a = match a\n  | Mk bal tag -> bal + tag\nmain =\n  let _ = print (show (total (Mk 100 7)))\n  0" "107"
  -- t142 (P2 Stage B / B1): an auth-typed ADT triggers projection synthesis. The
  -- compiler auto-derives digest_Tree (proj_of_Tree + sha256_hex) from the `auth`
  -- markers; its Merkle root MUST be byte-identical to the hand-written Stage A
  -- oracle (tools/auth/authkit.rail, at tag archive/tier3-step5-precut-2026-10-21 since
  -- 2026-10-21). The pinned hex is that oracle's live root.
  let t142 = run_test "auth_digest_merkle" "import \"stdlib/sha256.rail\"\ntype Tree = | Tip s | Bin auth Tree auth Tree\nmain =\n  let t = Bin (Bin (Tip \"alpha\") (Tip \"bravo\")) (Bin (Tip \"charlie\") (Tip \"delta\"))\n  let _ = print (digest_Tree t)\n  0" "afc59941de7c976817a9101ca0301139fca9a8fb844d4ccfbca8facbce8b9b5c"
  -- t143 (P2 Stage B / B2a): Ideal mode. The compiler synthesizes identity
  -- `unauth`/`auth_make`, so an auth-typed traversal written ONCE with `unauth`
  -- links and computes the plain value (the lambda-dot "free oracle"). Path
  -- [1,0] = right-then-left -> the "charlie" leaf.
  let t143 = run_test "auth_ideal_unauth" "import \"stdlib/sha256.rail\"\ntype Tree = | Tip s | Bin auth Tree auth Tree\nfetch t path = match unauth t\n  | Tip s -> s\n  | Bin l r -> if head path == 0 then fetch l (tail path) else fetch r (tail path)\nmain =\n  let t = Bin (Bin (Tip \"alpha\") (Tip \"bravo\")) (Bin (Tip \"charlie\") (Tip \"delta\"))\n  let _ = print (fetch t (cons 1 (cons 0 [])))\n  0" "charlie"
  -- t144 (P2 Stage B / B2b): Prover clone. The compiler synthesizes `fetch__prove`
  -- from the SAME `match unauth t` traversal: at every opened node it appends that
  -- node's shallow projection to a 1-cell proof buffer, then descends. Path [1,0]
  -- opens root, right child, then the "charlie" leaf -> 3 projections, value "charlie".
  -- Byte-for-byte the same proof authkit.rail's hand-written prover_fetch emits.
  let t144 = run_test "auth_prove_proof" "import \"stdlib/sha256.rail\"\ntype Tree = | Tip s | Bin auth Tree auth Tree\nfetch t path = match unauth t\n  | Tip s -> s\n  | Bin l r -> if head path == 0 then fetch l (tail path) else fetch r (tail path)\nmain =\n  let t = Bin (Bin (Tip \"alpha\") (Tip \"bravo\")) (Bin (Tip \"charlie\") (Tip \"delta\"))\n  let pbuf = arr_new 1 []\n  let v = fetch__prove t (cons 1 (cons 0 [])) pbuf\n  let pf = arr_get pbuf 0\n  let _ = print (cat [v, \" \", show (length pf)])\n  0" "charlie 3"
  -- t145-t148 (P2 Stage B / B2c): Verifier clone. The compiler synthesizes
  -- `fetch__verify` -- it holds ONLY the root digest + the prover's proof (NOT
  -- the tree), pops each projection, hash-checks vs the running expected digest,
  -- and reconstructs the variant by parsing the projection. The full prove->verify
  -- round-trip ACCEPTS the honest proof and REJECTS all three tamper classes,
  -- with the same accept/reject decisions as authkit.rail's hand-written verifier.
  let t145 = run_test "auth_verify_accept" "import \"stdlib/sha256.rail\"\ntype Tree = | Tip s | Bin auth Tree auth Tree\nfetch t path = match unauth t\n  | Tip s -> s\n  | Bin l r -> if head path == 0 then fetch l (tail path) else fetch r (tail path)\nmain =\n  let t = Bin (Bin (Tip \"alpha\") (Tip \"bravo\")) (Bin (Tip \"charlie\") (Tip \"delta\"))\n  let root = digest_Tree t\n  let path = cons 1 (cons 0 [])\n  let pbuf = arr_new 1 []\n  let _ = fetch__prove t path pbuf\n  let proof = arr_get pbuf 0\n  let vbuf = arr_new 1 []\n  let _ = arr_set vbuf 0 proof\n  let res = fetch__verify root path vbuf\n  let _ = print (if is_error res then \"REJECT\" else cat [\"accept:\", res])\n  0" "accept:charlie"
  let t146 = run_test "auth_verify_tamper_leaf" "import \"stdlib/sha256.rail\"\ntype Tree = | Tip s | Bin auth Tree auth Tree\nfetch t path = match unauth t\n  | Tip s -> s\n  | Bin l r -> if head path == 0 then fetch l (tail path) else fetch r (tail path)\nmain =\n  let t = Bin (Bin (Tip \"alpha\") (Tip \"bravo\")) (Bin (Tip \"charlie\") (Tip \"delta\"))\n  let root = digest_Tree t\n  let path = cons 1 (cons 0 [])\n  let pbuf = arr_new 1 []\n  let _ = fetch__prove t path pbuf\n  let proof = arr_get pbuf 0\n  let bad = cons (head proof) (cons (head (tail proof)) (cons \"T:HACKED\" []))\n  let vbuf = arr_new 1 []\n  let _ = arr_set vbuf 0 bad\n  let res = fetch__verify root path vbuf\n  let _ = print (if is_error res then \"REJECT\" else cat [\"accept:\", res])\n  0" "REJECT"
  let t147 = run_test "auth_verify_bad_root" "import \"stdlib/sha256.rail\"\ntype Tree = | Tip s | Bin auth Tree auth Tree\nfetch t path = match unauth t\n  | Tip s -> s\n  | Bin l r -> if head path == 0 then fetch l (tail path) else fetch r (tail path)\nmain =\n  let t = Bin (Bin (Tip \"alpha\") (Tip \"bravo\")) (Bin (Tip \"charlie\") (Tip \"delta\"))\n  let path = cons 1 (cons 0 [])\n  let pbuf = arr_new 1 []\n  let _ = fetch__prove t path pbuf\n  let proof = arr_get pbuf 0\n  let vbuf = arr_new 1 []\n  let _ = arr_set vbuf 0 proof\n  let res = fetch__verify \"deadbeef\" path vbuf\n  let _ = print (if is_error res then \"REJECT\" else cat [\"accept:\", res])\n  0" "REJECT"
  let t148 = run_test "auth_verify_tamper_node" "import \"stdlib/sha256.rail\"\ntype Tree = | Tip s | Bin auth Tree auth Tree\nfetch t path = match unauth t\n  | Tip s -> s\n  | Bin l r -> if head path == 0 then fetch l (tail path) else fetch r (tail path)\nmain =\n  let t = Bin (Bin (Tip \"alpha\") (Tip \"bravo\")) (Bin (Tip \"charlie\") (Tip \"delta\"))\n  let root = digest_Tree t\n  let path = cons 1 (cons 0 [])\n  let pbuf = arr_new 1 []\n  let _ = fetch__prove t path pbuf\n  let proof = arr_get pbuf 0\n  let bad = cons (head proof) (cons \"B:dead:beef\" (cons (head (tail (tail proof))) []))\n  let vbuf = arr_new 1 []\n  let _ = arr_set vbuf 0 bad\n  let res = fetch__verify root path vbuf\n  let _ = print (if is_error res then \"REJECT\" else cat [\"accept:\", res])\n  0" "REJECT"
  -- t149-t151 (P2 Stage B / B3): generalization to the asymmetric string-keyed BST.
  -- Node carries a plain key field plus two auth children; navigation is data-driven
  -- (slt key k), and the leaf-key binding guard (k == key) falls out of the user's
  -- own traversal. Proves the duplicator handles mixed plain+auth fields + order guard.
  let dict_src = "import \"stdlib/sha256.rail\"\ntype Dict = | Leaf k v | Node k auth Dict auth Dict\nslt a b = char_to_int (head (chars a)) < char_to_int (head (chars b))\nlookup d key = match unauth d\n  | Leaf k v -> if k == key then v else error \"absent\"\n  | Node k l r -> if slt key k then lookup l key else lookup r key\n"
  let t149 = run_test "auth_dict_accept" (cat [dict_src, "main =\n  let t = Node \"b\" (Leaf \"a\" \"apple\") (Leaf \"b\" \"banana\")\n  let root = digest_Dict t\n  let pb = arr_new 1 []\n  let _ = lookup__prove t \"a\" pb\n  let pa = arr_get pb 0\n  let vb = arr_new 1 []\n  let _ = arr_set vb 0 pa\n  let res = lookup__verify root \"a\" vb\n  let _ = print (if is_error res then \"REJECT\" else cat [\"accept:\", res])\n  0"]) "accept:apple"
  let t150 = run_test "auth_dict_wrong_key" (cat [dict_src, "main =\n  let t = Node \"b\" (Leaf \"a\" \"apple\") (Leaf \"b\" \"banana\")\n  let root = digest_Dict t\n  let pb = arr_new 1 []\n  let _ = lookup__prove t \"z\" pb\n  let pz = arr_get pb 0\n  let vb = arr_new 1 []\n  let _ = arr_set vb 0 pz\n  let res = lookup__verify root \"z\" vb\n  let _ = print (if is_error res then \"REJECT\" else cat [\"accept:\", res])\n  0"]) "REJECT"
  let t151 = run_test "auth_dict_tamper" (cat [dict_src, "main =\n  let t = Node \"b\" (Leaf \"a\" \"apple\") (Leaf \"b\" \"banana\")\n  let root = digest_Dict t\n  let pb = arr_new 1 []\n  let _ = lookup__prove t \"a\" pb\n  let pa = arr_get pb 0\n  let bad = cons (head pa) (cons \"L:a:HACKED\" [])\n  let vb = arr_new 1 []\n  let _ = arr_set vb 0 bad\n  let res = lookup__verify root \"a\" vb\n  let _ = print (if is_error res then \"REJECT\" else cat [\"accept:\", res])\n  0"]) "REJECT"
  -- t152 (P2 Stage B / B4): length-prefix framing closes the ':'-collision. A leaf
  -- value containing a colon must round-trip: under the old ':'-join the verifier
  -- silently truncated "ap:ple" -> "ap" yet ACCEPTED (a soundness hole); framing
  -- recovers the exact bytes by declared length.
  let t152 = run_test "auth_dict_colon_value" (cat [dict_src, "main =\n  let t = Node \"b\" (Leaf \"a\" \"ap:ple\") (Leaf \"b\" \"banana\")\n  let root = digest_Dict t\n  let pb = arr_new 1 []\n  let _ = lookup__prove t \"a\" pb\n  let pa = arr_get pb 0\n  let vb = arr_new 1 []\n  let _ = arr_set vb 0 pa\n  let res = lookup__verify root \"a\" vb\n  let _ = print (if is_error res then \"REJECT\" else cat [\"accept:\", res])\n  0"]) "accept:ap:ple"
  -- t153 (P3 / C0-A): forward-mode AD desugar. #grad f synthesizes f__grad x __gi,
  -- itself pure Rail. f x = x*x + 3x  =>  f'(x) = 2x+3 (selector __gi=0, sole input).
  -- f'(2)=7 f'(5)=13 f'(0)=3.
  let t153 = run_test "p3_grad_forward_scalar" "#grad f\nf x = (x *. x) +. (3.0 *. x)\nmain =\n  let _ = print (cat [show_float (f__grad 2.0 0), \" \", show_float (f__grad 5.0 0), \" \", show_float (f__grad 0.0 0)])\n  0" "7 13 3"
  -- t154 (P3 / C1): multi-input forward-mode. f x y = x*y + 3x. The synthesized
  -- f__grad x y __gi selects the partial by __gi: df/dx=y+3 (0), df/dy=x (1). At (2,5): 8 2.
  let t154 = run_test "p3_grad_multi_input" "#grad f\nf x y = (x *. y) +. (3.0 *. x)\nmain =\n  let _ = print (cat [show_float (f__grad 2.0 5.0 0), \" \", show_float (f__grad 2.0 5.0 1)])\n  0" "8 2"
  -- t155 (P3 / C2): transcendental forward-mode. f x = sqrt x => f'(x)=1/(2*sqrt x),
  -- emitted constant-free as du/(sqrt x + sqrt x). f'(4)=0.25 f'(1)=0.5 f'(0.25)=1.
  let t155 = run_test "p3_grad_transcendental" "#grad f\nf x = sqrt x\nmain =\n  let _ = print (cat [show_float (f__grad 4.0 0), \" \", show_float (f__grad 1.0 0), \" \", show_float (f__grad 0.25 0)])\n  0" "0.25 0.5 1"
  -- t156 (P3 / C2): forward-mode through let. f x = let a = x*.x in a +. a (a shared) => f=2x^2,
  -- f'=4x. The desugar emits primal `let a=...` + tangent `let a__d=...`. f'(3)=12 f'(1.5)=6 f'(0)=0.
  let t156 = run_test "p3_grad_let" "#grad f\nf x = let a = x *. x in a +. a\nmain =\n  let _ = print (cat [show_float (f__grad 3.0 0), \" \", show_float (f__grad 1.5 0), \" \", show_float (f__grad 0.0 0)])\n  0" "12 6 0"
  -- t157 (P3 / C4.0): reverse-mode. #grad f ALSO synthesizes f__rgrad <params> __go,
  -- one backward sweep writing every partial into the float_arr __go. f x y = x*y+3x
  -- at (2,5): df/dx=y+3=8 (idx 0), df/dy=x=2 (idx 1). Must match the forward oracle.
  let t157 = run_test "p3_rgrad_multi" "#grad f\nf x y = (x *. y) +. (3.0 *. x)\nmain =\n  let go = float_arr_new 2 0.0\n  let _ = f__rgrad 2.0 5.0 go\n  let _ = print (cat [show_float (float_arr_get go 0), \" \", show_float (float_arr_get go 1)])\n  0" "8 2"
  -- t158: float-return inference for a fn whose return-expr is float ONLY via
  -- float params (no FL literal to anchor it). fb x y = (x /. y) -. y was
  -- mis-inferred int-returning, so nested arithmetic (fb ..) +. (fb ..)
  -- reinterpreted the raw double bits as a tagged int -> garbage/segfault.
  -- fb 10 2 = 5-2 = 3; 3+3 = 6. Locks the param-float-aware third fret pass.
  let t158 = run_test "float_ret_param_only" "fb x y = (x /. y) -. y\nmain =\n  let s = (fb 10.0 2.0) +. (fb 10.0 2.0)\n  let _ = print (show_float s)\n  0" "6"
  -- t159 (P3 / C4.1): reverse-mode through a let-SPINE. f a b = let x=a*b in let y=x+a
  -- in y*x  (= (ab+a)(ab)). One backward sweep materializes each intermediate adjoint
  -- as a let (x is reused by y and the product -- contributions accumulate). At (3,2):
  -- df/da = 2ab^2+2ab = 36, df/db = 2a^2 b+a^2 = 45. Locks reverse-through-let.
  let t159 = run_test "p3_rgrad_let" "#grad f\nf a b =\n  let x = a *. b\n  let y = x +. a\n  y *. x\nmain =\n  let go = float_arr_new 2 0.0\n  let _ = f__rgrad 3.0 2.0 go\n  let _ = print (cat [show_float (float_arr_get go 0), \" \", show_float (float_arr_get go 1)])\n  0" "36 45"
  -- t160 (P3 / C4.2): reverse-mode through a transcendental. f x = (exp x)*(exp x) =
  -- exp(2x), so df/dx = 2 exp(2x); at x=0 that is exactly 2. Exercises the exp local
  -- factor, the product rule, and accumulation of two contributions onto the same leaf x.
  let t160 = run_test "p3_rgrad_trans" "#grad f\nf x = (exp x) *. (exp x)\nmain =\n  let go = float_arr_new 1 0.0\n  let _ = f__rgrad 0.0 go\n  let _ = print (show_float (float_arr_get go 0))\n  0" "2"
  -- t161 (P3 / C5.0): forward-mode through control flow. relu x = if x >. 0.0 then x
  -- else 0.0; the piecewise derivative is the step function (if x>0 then 1 else 0). At
  -- x=2.0 the active branch is x, so relu'(2)=1 -- not the 0.0 a missing "?" case gives.
  let t161 = run_test "p3_grad_if" "#grad relu\nrelu x = if x >. 0.0 then x else 0.0\nmain =\n  let sd = float_arr_new 1 0.0\n  let _ = float_arr_set sd 0 (relu__grad 2.0 0)\n  let _ = print (show_float (float_arr_get sd 0))\n  0" "1"
  -- t162 (P3 / C5.1): reverse-mode through control flow. Same relu, but f__rgrad writes the
  -- adjoint into __go. At x=2.0 the active branch is x, so the step function gives 1 -- the
  -- reverse sweep guards the cotangent by the primal predicate, mirroring forward-mode's "?".
  let t162 = run_test "p3_grad_rev_if" "#grad relu\nrelu x = if x >. 0.0 then x else 0.0\nmain =\n  let go = float_arr_new 1 0.0\n  let _ = relu__rgrad 2.0 go\n  let _ = print (show_float (float_arr_get go 0))\n  0" "1"
  -- t163 (P3 / C5.2): forward-mode through a match. am = absf via an int-discriminant match
  -- (sgn3 x selects the arm). d/dx of the active arm | 1 -> x at x=2.0 is the step value 1 --
  -- each arm body is differentiated; the scrutinee is a primal-only discriminant.
  let t163 = run_test "p3_grad_match" "sgn3 x = if x >. 0.0 then 1 else (if x <. 0.0 then 0 else 2)\n#grad am\nam x = match sgn3 x\n  | 1 -> x\n  | 0 -> 0.0 -. x\n  | _ -> 0.0\nmain =\n  let _ = print (show_float (am__grad 2.0 0))\n  0" "1"
  -- t164 (P3 / C5.2): reverse-mode through the same match. am__rgrad writes the adjoint into
  -- __go; before C5.2 grad_rev_flat punted "M" so NO f__rgrad was synthesized (a link error).
  -- The reverse sweep guards the cotangent per-arm by the same discriminant, mirroring t163.
  let t164 = run_test "p3_grad_rev_match" "sgn3 x = if x >. 0.0 then 1 else (if x <. 0.0 then 0 else 2)\n#grad am\nam x = match sgn3 x\n  | 1 -> x\n  | 0 -> 0.0 -. x\n  | _ -> 0.0\nmain =\n  let go = float_arr_new 1 0.0\n  let _ = am__rgrad 2.0 go\n  let _ = print (show_float (float_arr_get go 0))\n  0" "1"
  let s1 =(if t1 then 1 else 0) + (if t2 then 1 else 0) + (if t3 then 1 else 0) + (if t4 then 1 else 0) + (if t5 then 1 else 0) + (if t6 then 1 else 0) + (if t7 then 1 else 0) + (if t8 then 1 else 0) + (if t9 then 1 else 0) + (if t10 then 1 else 0)
  let s2 = (if t11 then 1 else 0) + (if t12 then 1 else 0) + (if t13 then 1 else 0) + (if t14 then 1 else 0) + (if t15 then 1 else 0) + (if t16 then 1 else 0) + (if t17 then 1 else 0) + (if t18 then 1 else 0) + (if t19 then 1 else 0) + (if t20 then 1 else 0)
  let s3 = (if t21 then 1 else 0) + (if t22 then 1 else 0) + (if t23 then 1 else 0) + (if t24 then 1 else 0) + (if t25 then 1 else 0) + (if t26 then 1 else 0) + (if t27 then 1 else 0) + (if t28 then 1 else 0) + (if t29 then 1 else 0) + (if t30 then 1 else 0)
  let s4 = (if t31 then 1 else 0) + (if t32 then 1 else 0) + (if t33 then 1 else 0) + (if t34 then 1 else 0) + (if t35 then 1 else 0) + (if t36 then 1 else 0) + (if t37 then 1 else 0) + (if t38 then 1 else 0) + (if t39 then 1 else 0) + (if t40 then 1 else 0)
  let s5 = (if t41 then 1 else 0) + (if t42 then 1 else 0) + (if t43 then 1 else 0) + (if t44 then 1 else 0) + (if t45 then 1 else 0) + (if t46 then 1 else 0) + (if t47 then 1 else 0) + (if t48 then 1 else 0) + (if t49 then 1 else 0) + (if t50 then 1 else 0)
  let s6 = (if t51 then 1 else 0) + (if t52 then 1 else 0) + (if t53 then 1 else 0) + (if t54 then 1 else 0) + (if t55 then 1 else 0) + (if t56 then 1 else 0) + (if t57 then 1 else 0) + (if t58 then 1 else 0) + (if t59 then 1 else 0) + (if t60 then 1 else 0)
  let s7 = (if t61 then 1 else 0) + (if t62 then 1 else 0) + (if t63 then 1 else 0) + (if t64 then 1 else 0) + (if t65 then 1 else 0) + (if t68 then 1 else 0) + (if t69 then 1 else 0) + (if t70 then 1 else 0)
  let s8 = (if t71 then 1 else 0) + (if t72 then 1 else 0) + (if t73 then 1 else 0) + (if t74 then 1 else 0) + (if t75 then 1 else 0) + (if t76 then 1 else 0) + (if t77 then 1 else 0) + (if t78 then 1 else 0) + (if t79 then 1 else 0) + (if t80 then 1 else 0)
  let s9 = (if t81 then 1 else 0) + (if t82 then 1 else 0) + (if t83 then 1 else 0) + (if t84 then 1 else 0) + (if t85 then 1 else 0) + (if t86 then 1 else 0) + (if t87 then 1 else 0) + (if t88 then 1 else 0) + (if t89 then 1 else 0) + (if t90 then 1 else 0)
  let s10 = (if t91 then 1 else 0) + (if t92 then 1 else 0) + (if t93 then 1 else 0) + (if t94 then 1 else 0) + (if t95 then 1 else 0) + (if t96 then 1 else 0) + (if t97 then 1 else 0) + (if t98 then 1 else 0)
  let s11 = (if t99 then 1 else 0) + (if t100 then 1 else 0) + (if t101 then 1 else 0) + (if t102 then 1 else 0) + (if t103 then 1 else 0) + (if t104 then 1 else 0) + (if t106 then 1 else 0) + (if t107 then 1 else 0) + (if t111 then 1 else 0) + (if t112 then 1 else 0) + (if t113 then 1 else 0) + (if t114 then 1 else 0) + (if t115 then 1 else 0) + (if t116 then 1 else 0) + (if t117 then 1 else 0) + (if t118 then 1 else 0) + (if t119 then 1 else 0) + (if t120 then 1 else 0) + (if t121 then 1 else 0) + (if t122 then 1 else 0) + (if t123 then 1 else 0) + (if t124 then 1 else 0) + (if t125 then 1 else 0) + (if t126 then 1 else 0) + (if t127 then 1 else 0) + (if t128 then 1 else 0) + (if t129 then 1 else 0) + (if t130 then 1 else 0) + (if t131 then 1 else 0) + (if t132 then 1 else 0) + (if t133 then 1 else 0) + (if t134 then 1 else 0) + (if t135 then 1 else 0) + (if t136 then 1 else 0) + (if t137 then 1 else 0) + (if t138 then 1 else 0) + (if t139 then 1 else 0) + (if t140 then 1 else 0) + (if t141 then 1 else 0) + (if t142 then 1 else 0) + (if t143 then 1 else 0) + (if t144 then 1 else 0) + (if t145 then 1 else 0) + (if t146 then 1 else 0) + (if t147 then 1 else 0) + (if t148 then 1 else 0) + (if t149 then 1 else 0) + (if t150 then 1 else 0) + (if t151 then 1 else 0) + (if t152 then 1 else 0) + (if t153 then 1 else 0) + (if t154 then 1 else 0) + (if t155 then 1 else 0) + (if t156 then 1 else 0) + (if t157 then 1 else 0) + (if t158 then 1 else 0) + (if t159 then 1 else 0) + (if t160 then 1 else 0) + (if t161 then 1 else 0) + (if t162 then 1 else 0) + (if t163 then 1 else 0) + (if t164 then 1 else 0)
  -- Track B: cross-function return-type inference (precise-GC plan).
  let i1 = run_infer_test "pure_int" "square x = x * x\nmain = square 7" "square" 1
  let i2 = run_infer_test "pure_float" "halve x = x +. 0.0\nmain = 0" "halve" 2
  let i3 = run_infer_test "list_return" "mklist x = cons x (cons (x + 1) [])\nmain = 0" "mklist" 3
  let i4 = run_infer_test2 "mutual_rec" "evnp n = if n == 0 then 1 else oddp (n - 1)\noddp n = if n == 0 then 0 else evnp (n - 1)\nmain = evnp 10" "evnp" 1 "oddp" 1
  let i5 = run_infer_test "adt_ctor" "type Box = | MkBox v\nwrap x = MkBox x\nmain = 0" "wrap" 3
  -- Constructor fields are untyped (dyn), so `r * r * 3` may be a float: UNKNOWN. The
  -- guessing pass this replaced said INT, which a `Circ 1.5` contradicts.
  let i6 = run_infer_test "match_int" "type Shape = | Circ r | Sq s\narea sh = match sh\n  | Circ r -> r * r * 3\n  | Sq s -> s * s\nmain = 0" "area" 0
  -- ...and the same match over fields declared int is INT.
