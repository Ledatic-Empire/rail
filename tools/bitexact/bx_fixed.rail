-- BX fixed-point integer library (no main; importable).
-- Since 2026-10-21 (Tier 3, step 4) the algorithms live in stdlib/math_exact.rail under fx_
-- names; this file forwards the bx4_ names the BX4+ and R1a gates use, so those gates now
-- exercise the stdlib copy. F = 24, S = 2^24; see the stdlib file for domains and precision.

import "stdlib/math_exact.rail"

bx4_topbit_a n d = fx_topbit_a n d
bx4_topbit_b n d = fx_topbit_b n d
bx4_topbit n d = fx_topbit n d
bx4_isqrt_a n c d = fx_isqrt_a n c d
bx4_isqrt_b n c d = fx_isqrt_b n c d
bx4_isqrt n = fx_isqrt n
bx4_fxsqrt xq = fx_sqrt xq
bx4_fxrsqrt xq = fx_rsqrt xq
bx4_pow2 k = fx_pow2 k
bx4_exp_poly fq = fx_exp_poly fq
bx4_exp_neg ax = fx_exp_neg ax
bx4_exp_pos xq = fx_exp_pos xq
bx4_fxexp xq = fx_exp xq
bx4_tanh xq = fx_tanh xq
bx4_gelu xq = fx_gelu xq
bx4_gelu_grad xq = fx_gelu_grad xq
bx4_quant x = fx_quant x
bx4_back rq = fx_back rq
bx4_fabs x = if x <. 0.0 then 0.0 -. x else x
bx4_sin_unit aq = fx_sin_unit aq
bx4_cos_unit aq = fx_cos_unit aq
bx4_sin th = fx_sin th
bx4_cos th = fx_cos th
bx4_reduce2pi th = fx_reduce_2pi th
bx4_sinb th = fx_sin_any th
bx4_cosb th = fx_cos_any th
