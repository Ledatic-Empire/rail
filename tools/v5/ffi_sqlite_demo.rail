-- tools/v5/ffi_sqlite_demo.rail — P5 proof: an FFI binary linked by the pure-Rail
-- Mach-O linker (libsqlite3 bound by us, no `ld`).
--
-- The Rail linker (tools/v5/link_lib.rail) emits a 2nd LC_LOAD_DYLIB for
-- /usr/lib/libsqlite3.dylib and binds the sqlite3_* imports to dylib ordinal 2
-- (libSystem stays ordinal 1). Build + rail-link this WITHOUT as/ld:
--
--   ./rail_native linux tools/v5/ffi_sqlite_demo.rail   # writes the macOS .s to
--                                                        #   /tmp/rail_macos.s
--   ./rail_native run tools/independence/link_file.rail /tmp/rail_macos.s /tmp/v5_rail
--                                                        #   the signed Mach-O, linked in process
--   /tmp/v5_rail                                         # runs this demo's main
--
-- otool -L /tmp/v5_rail shows libSystem + libsqlite3; it prints "sqlite says: 42".

import "stdlib/sqlite.rail"

main =
  let db = sq_open ":memory:"
  let csql = sq_strdup "CREATE TABLE t(n); INSERT INTO t VALUES(42);"
  let _ = sqlite3_exec db csql 0 0 0
  let _ = free csql
  let st = sq_prepare db "SELECT n FROM t"
  let _ = sqlite3_step st
  let v = sqlite3_column_int st 0
  let _ = sqlite3_finalize st
  let _ = sqlite3_close db
  let _ = print (cat ["sqlite says: ", show v])
  0
