  "_rail_free_list_alloc:\n    cmp x0, #16\n    b.ne .Lfla_t24\n    adrp x4, _rail_free_16@PAGE\n    add x4, x4, _rail_free_16@PAGEOFF\n    ldr x2, [x4]\n    cbz x2, .Lfla_main\n    ldr x3, [x2, #8]\n    str x3, [x4]\n    mov x0, x2\n    ret\n.Lfla_t24:\n    cmp x0, #24\n    b.ne .Lfla_main\n    adrp x4, _rail_free_24@PAGE\n    add x4, x4, _rail_free_24@PAGEOFF\n    ldr x2, [x4]\n    cbz x2, .Lfla_main\n    ldr x3, [x2, #8]\n    str x3, [x4]\n    mov x0, x2\n    ret\n.Lfla_main:\n    adrp x1, _rail_free_list@PAGE\n    add x1, x1, _rail_free_list@PAGEOFF\n",
  ".Lfla_loop:\n    ldr x2, [x1]\n    cbz x2, .Lfla_fail\n    ldr x3, [x2]\n    cmp x3, x0\n    b.ge .Lfla_found\n    add x1, x2, #8\n    b .Lfla_loop\n",
