-- tools/verify/examples_check.rail: every example runs and prints what examples/expected says.
--
-- For each examples/<name>.rail: compile it, run it with the arguments in
-- examples/expected/<name>.args when that file exists, and compare its standard output, byte
-- for byte, with examples/expected/<name>.txt; the program must also exit 0. An expected file
-- whose first line starts with "error: " says the compiler must refuse the example and names
-- text its message must contain (examples/error_test.rail shows a diagnostic). An example with
-- no expected file fails: every example is a claim about the language.
--
-- Every finding is printed; the last line is PASS or FAIL. Exit 0 iff PASS.
-- Run from the repo root:  ./rail_native run tools/verify/examples_check.rail
-- To accept a new or changed output, write the file by hand after reading it; nothing here
-- regenerates expectations. Each example is compiled at RAIL_ARENA_MB=3000: a program that
-- imports the TLS stack (examples/life_beacon.rail, 26 files and 269 KB of source with its
-- imports) thrashes the collector at the default 1 GB arena and compiles in under 2 s from
-- 1500 up (measured 2026-10-29). `shell` passes no environment through, so the setting is
-- part of the command.

cat parts = join "" parts

starts_with prefix s = if length prefix > length s then false else str_sub s 0 (length prefix) == prefix

-- trailing newlines off
rstrip_nl s = join "" (reverse (drop_nl (reverse (chars s))))
drop_nl cs = if cs == [] then [] else if head cs == "\n" then drop_nl (tail cs) else cs

-- lines of a shell listing, the empty tail dropped
nonempty xs = if xs == [] then [] else if head xs == "" then nonempty (tail xs) else cons (head xs) (nonempty (tail xs))

file_exists p = rstrip_nl (shell (cat ["test -e '", p, "' && echo yes || echo no"])) == "yes"

-- "examples/name.rail" -> "name"
name_of path = str_sub path 9 (length path - 14)

-- the last line of a text and the text before it (blank lines kept: they are output too)
split_last s =
  let t = rstrip_nl s
  let i = last_nl (chars t) 0 (0 - 1)
  if i < 0 then ("", t) else (str_sub t 0 i, str_sub t (i + 1) (length t - i - 1))
last_nl cs i best = if cs == [] then best else last_nl (tail cs) (i + 1) (if head cs == "\n" then i else best)

-- one example; prints its findings, returns their count
check_example path =
  let name = name_of path
  let exp_path = cat ["examples/expected/", name, ".txt"]
  let args_path = cat ["examples/expected/", name, ".args"]
  let bin = cat ["/tmp/examples_check_", name]
  if file_exists exp_path == false then
    let _ = print (cat ["  FAIL ", path, ": no examples/expected/", name, ".txt"])
    1
  else
    let expected = read_file exp_path
    if starts_with "error: " expected then check_refused path bin (head (split "\n" (str_sub expected 7 (length expected - 7))))
    else
      let args = if file_exists args_path then rstrip_nl (read_file args_path) else ""
      check_runs path bin args (rstrip_nl expected)

-- the compiler must refuse the program and say `want`
check_refused path bin want =
  let out = shell (cat ["RAIL_ARENA_MB=3000 ./rail_native --out-prefix ", bin, " ", path, " 2>&1; echo \"EXIT $?\""])
  let (body, last) = split_last out
  if last == "EXIT 0" then
    let _ = print (cat ["  FAIL ", path, ": compiled, but its expected file says the compiler must refuse it"])
    1
  else if str_contains want out == false then
    let _ = print (cat ["  FAIL ", path, ": refused without the expected text: ", want])
    1
  else
    let _ = print (cat ["  ok   ", path, ": refused, says: ", want])
    0

-- the program must compile, exit 0 and print exactly `expected`
check_runs path bin args expected =
  let built = shell (cat ["RAIL_ARENA_MB=3000 ./rail_native --out-prefix ", bin, " ", path, " >/dev/null 2>&1; echo \"EXIT $?\""])
  if rstrip_nl built != "EXIT 0" then
    let _ = print (cat ["  FAIL ", path, ": did not compile"])
    1
  else
    let out = shell (cat ["(", bin, " ", args, "; echo \"EXIT $?\") 2>/dev/null"])
    let (body, last) = split_last out
    if last != "EXIT 0" then
      let _ = print (cat ["  FAIL ", path, ": ", last])
      1
    else if rstrip_nl body != expected then
      let _ = print (cat ["  FAIL ", path, ": output differs from examples/expected (first differing line below)"])
      let _ = first_diff (split "\n" expected) (split "\n" (rstrip_nl body)) 1
      1
    else
      let _ = print (cat ["  ok   ", path, if args == "" then "" else cat [" (args: ", args, ")"]])
      0

first_diff want got ln =
  if want == [] && got == [] then 0
  else if want == [] then print (cat ["         line ", show ln, ": expected end of output, got: ", head got])
  else if got == [] then print (cat ["         line ", show ln, ": expected: ", head want, ", got end of output"])
  else if head want == head got then first_diff (tail want) (tail got) (ln + 1)
  else
    let _ = print (cat ["         line ", show ln, ": expected: ", head want])
    print (cat ["         line ", show ln, ": got:      ", head got])

check_all paths = if paths == [] then 0 else check_example (head paths) + check_all (tail paths)

main =
  let paths = nonempty (split "\n" (shell "ls examples/*.rail"))
  let _ = print (cat ["examples_check: ", show (length paths), " examples"])
  let n = check_all paths
  if n == 0 then
    let _ = print (cat ["PASS examples_check: ", show (length paths), " examples compile, run and print their expected output"])
    0
  else
    let _ = print (cat ["FAIL examples_check: ", show n, " finding(s)"])
    1
